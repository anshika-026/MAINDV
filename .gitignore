# ---------------------------------------------------------------------------
# Runtime application data — NEVER commit. This is the live SQLite database,
# face captures, enrollment photos, training images, Re-ID and alert
# snapshots, and the trained classifier: biometric data of real people.
# It is machine-specific and constantly changing. Back it up with the
# procedure in DEPLOYMENT.md, not with git. See GIT_DATA_CLEANUP.md.
# ---------------------------------------------------------------------------
backend/data/
backend/data_backup*/
backend/data-*/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.joblib
*.joblib.bak-*
*.bak-*

# Logs written by the backend (LOG_DIR).
backend/logs/
*.log

# Local secrets/config — real per-machine values (camera hosts, secrets,
# admin bootstrap password). The *.example templates stay tracked.
.env
.env.*
!.env.example
!frontend/.env.production
*.pem
*.key
*.p12
*.pfx

# Model weights are provisioned per deployment (scripts/fetch_models.py,
# DEPLOYMENT.md), not versioned in git.
backend/models/*
!backend/models/README.md
!backend/models/emotion_model_v3.keras
*.pt
*.pth
*.onnx

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
.venv-*/
venv/

# Node/frontend build output
node_modules/
dist/

# Editor / OS noise
.DS_Store
Thumbs.db

# Local editor/assistant tooling state — not application source code.
.claude/
