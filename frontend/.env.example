# Copy to frontend/.env for local development (npm run dev).
# Backend API base URL. Local dev backend: http://127.0.0.1:8821/api
# Production builds use .env.production (relative /api) instead.
VITE_API_BASE_URL=http://127.0.0.1:8821/api
# true = show sample data on pages that have no backend yet (demo only).
VITE_DEMO_MODE=false
