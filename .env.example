
# Copy this file to .env and fill in real camera credentials before
# running. Never commit the real .env - it contains camera passwords.

# PPE detection mode. "crop" runs a zoomed-in crop per person (what
# actually finds helmet/mask/goggles on this camera - see below), and
# nothing else. Was "both" (crop AND a full-frame pass), which ran PPE
# inference twice per cycle for no benefit here - the frame-level pass
# has never found anything real on this camera that the crops didn't
# already find, and it was part of why one detection cycle was taking
# 12-40 seconds against a 0.5s target on this CPU.
# IMC stall demo: restrict live dashboard to only backpack, handbag,
# bottle (water bottle) and laptop. Person still detected internally
# for PPE/tracking, just not filtered by this.
IMC_DEMO_MODE=1

# 0.30 was silently dropping real detections - a genuine bottle on a
# live frame scored 0.252 (verified directly against the specialist
# model's raw output) and got thrown away by this threshold, despite
# the model itself finding it correctly. Matches this codebase's
# existing "small object" floor (SMALL_OBJECT_CONFIDENCE) instead
# of the arbitrary 0.30 first guess.
# Lowered further to 0.15: real validation showed backpack recall at
# only 25% (99.6% precision) - the model is very rarely WRONG when it
# fires, it just doesn't fire often enough. A lower floor trades a
# little precision for a lot more recall until the retrained model
# (more diverse backpack/bottle/phone data) is deployed.
IMC_SPECIALIST_CONFIDENCE=0.15

# Same reasoning as IMC_SPECIALIST_CONFIDENCE above - a real phone in a
# person's hand on live footage scored 0.18 and was thrown away by the
# 0.25 default, despite the model finding it correctly.
PHONE_CROP_CONFIDENCE=0.15

PPE_MODE=crop

# The primary YOLO26 PPE model detects mask well but has almost no
# recall for helmet/no-helmet on this office's fisheye ceiling camera
# angle (verified: zero candidate boxes at any confidence). The
# dedicated 2-class hard_hat_best.pt model, run on the same person
# crop, correctly found "no helmet" where the primary model found
# nothing at all.
USE_DEDICATED_HELMET_MODEL=1

# Default 0.25 let through wrong low-confidence guesses on this camera -
# verified on a real frame: white desk partitions and a wall photo frame
# were labelled "tv" at 0.28-0.42 confidence (COCO's tv/monitor class
# false-triggers on flat rectangular things, made worse by this camera's
# fisheye distortion). Genuine detections in the same frame (person,
# chair, laptop) were all 0.46+, so raising the floor cuts the wrong
# guesses without losing the real ones.
GENERAL_CONFIDENCE=0.45

# The small-object floor (for laptop/backpack/bottle) was catching real
# laptops the 0.45 floor missed, but live feedback showed it also let
# real false hits through at the same low confidence (whiteboard called
# "laptop", wrong bottle guesses) - worse than the miss it was fixing,
# since a wrong label actively misleads rather than just showing
# nothing. Raised partway back up from the code default of 0.18.
SMALL_OBJECT_CONFIDENCE=0.32

# Real per-cycle detection time was measured at 10-40 seconds against a
# 0.5s target on a CPU-only machine (i3, no GPU) - stacking the general
# model, fixtures model, dedicated helmet model and PPE crops per person
# was too much work per frame. On a GPU (this project auto-detects CUDA,
# no config needed) these numbers stop being a bottleneck.
PPE_CROP_IMGSZ=416
PPE_MAX_CROPS=3
# Reverted: 480 measurably broke laptop detection (0.86 confidence at
# 640 dropped to 0 at 480 on the same real frame) - not worth the
# small speed gain. Keep the general model at full resolution.
GENERAL_IMGSZ=640

# Default target was 2.0 (a detection every 0.5s); on CPU-only hardware
# a real cycle measured 5-19s, so this was lowered to avoid the
# pipeline constantly falling behind. Can likely go back up on GPU.
OBJECT_DETECTION_FPS=0.15

# Default 0.45 let many overlapping duplicate boxes for the SAME real
# object survive - measured on the cluttered desk-partition/monitor
# area: 8-9 separate overlapping "tv" guesses for what is really 1-2
# monitors. Lower IoU merges overlapping same-class boxes more
# aggressively during NMS, collapsing duplicates into the single
# strongest one instead of showing all of them.
GENERAL_IOU=0.30

# RT-DETR-L zero-shot fallback (Ultralytics rtdetr-l) - tested and
# confirmed it correctly fills gaps the specialist misses. Running it
# every detection cycle on 3 concurrent camera pipelines pushed cycle
# latency to 95-206s on CPU, so it's throttled process-wide
# (YOLOS_FALLBACK_MIN_INTERVAL_S) instead of paying that cost every
# cycle on every camera. Can be lowered a lot on GPU.
YOLOS_FALLBACK_ENABLED=1
YOLOS_FALLBACK_MIN_INTERVAL_S=6
PHONE_FALLBACK_MIN_INTERVAL_S=6

# Pushed down to 0.3 for max recall at one point, but that let real
# false hits through live (chair/backpack called "handbag") - worse
# than a missed object, since it actively misleads. This is the safer
# middle ground.
YOLOS_FALLBACK_CONFIDENCE=0.5

# --- Camera credentials - fill in real values, never commit this file ---

# Camera 2
CAM2_HOST=
CAM2_PORT=
CAM2_USER=
CAM2_PASSWORD=
CAM2_STREAM_PATH=/h264/ch1/sub/av_stream

# Camera 3
CAM3_HOST=
CAM3_PORT=
CAM3_USER=
CAM3_PASSWORD=
CAM3_STREAM_PATH=/h264/ch1/sub/av_stream
