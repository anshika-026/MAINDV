HOST=127.0.0.1
PORT=8821
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
LIVE_STREAM_FPS=8

# --- Unique footfall (app/footfall.py, app/reid/config.py) ---
# Gate cameras are the ones with purpose "Entry/Exit"; draw each gate's
# counting zone on the Footfall UAT page. Restart the backend after editing.
# How alike two sightings must look to be the same person (0-1). Lower merges
# more (risk: two people counted as one); higher splits more.
REID_SIMILARITY_THRESHOLD=0.75
# Seconds between looks at each gate. Lower = smoother tracking, more CPU.
# A walker must be seen 3 times inside the zone to be counted.
REID_MOT_INTERVAL_SECONDS=0.5
# Skip body boxes squatter than this height:width (seated / head-only crops).
REID_MIN_ASPECT_RATIO=1.5
# Store a new view of a known person when it matched below this similarity...
REID_LEARN_BELOW_SIMILARITY=0.88
# ...up to this many stored views per person.
REID_MAX_EMBEDDINGS_PER_PERSON=30

# --- Live-view person boxes (app/face_pipeline.py) ---
# Lighter settings for this laptop: the overlay runs only while someone watches
# the live feed, and at the defaults (960 px + a yolov8s "rescue" pass every
# 6 frames) it starved the video thread down to ~2 fps. Footfall does its own
# person detection and isn't affected. Remove these lines to go back.
PERSON_DETECT_IMGSZ=640
PERSON_RESCUE_INTERVAL_FRAMES=100000
