# Deco Vision backend configuration. Copy to backend/.env (development) or
# provide as real environment variables / a systemd EnvironmentFile
# (production). Real environment variables override this file.
# Every setting is read in app/config.py; defaults shown are what you get
# when a line is omitted.

# --- Environment ---------------------------------------------------------------
# development | production | test. production turns on strict validation
# (refuses to start with an unsafe config), file logging, offline models,
# and turns off /docs.
APP_ENV=development

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8821
# Browser origins allowed to call the API (comma separated, never *).
# Production: your https site, e.g. https://vision.example.com
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# ENABLE_API_DOCS=false
# Behind nginx: trust X-Forwarded-For for the client IP (login throttling).
# TRUST_PROXY_HEADERS=true

# --- Secrets (production: REQUIRED, never commit real values) ------------------
# 64 hex chars:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# One-time bootstrap of the first admin (only used when no admin exists).
# Prefer: python -m app.manage create-admin --email you@example.com
# If you use these, remove ADMIN_PASSWORD after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Paths -------------------------------------------------------------------
# DATA_DIR=./data                 # database, captures, snapshots, classifier
# DB_PATH=./data/app.db
# MODEL_DIR=./models              # YOLO / Re-ID / emotion weights
# LOG_DIR=./logs

# --- Models (offline-first) -----------------------------------------------------
# true = never download model weights at runtime (default in production).
# MODEL_OFFLINE_MODE=false
# InsightFace looks for <root>/models/buffalo_l
# INSIGHTFACE_ROOT=~/.insightface

# --- External Identity (face-enrollment) service ---------------------------------
# Reached only by the backend. Must be https:// in production. Empty = the
# People roster sync and gallery sync report "not configured".
IDENTITY_SERVICE_BASE=
# EXTERNAL_HTTP_TIMEOUT=15

# --- Auth ----------------------------------------------------------------------
# SESSION_TTL_HOURS=12
# PASSWORD_MIN_LENGTH=10
# LOGIN_RATE_WINDOW_SECONDS=300
# LOGIN_RATE_LIMIT_PER_IP=20
# LOGIN_RATE_LIMIT_PER_USER=5
# MAX_UPLOAD_MB=5

# --- Cameras / RTSP ----------------------------------------------------------------
# LIVE_STREAM_FPS=8
# RTSP_CONNECT_TIMEOUT=20        # seconds to open a stream (NVRs over WAN are slow)
# RTSP_READ_TIMEOUT=10           # seconds one read may block
# RTSP_RECONNECT_DELAY=2         # first retry; doubles up to the max
# RTSP_RECONNECT_MAX_DELAY=60    # keeps NVRs from locking the account
# RTSP_MAX_RETRIES=10            # failures before a camera is reported FAILED
# CAMERA_FRAME_TIMEOUT=20        # no frame for this long = stalled, restart
# CAMERA_WATCHDOG_INTERVAL=2

# --- Analytics recovery ----------------------------------------------------------
# FEATURE_RETRY_BASE_SECONDS=5
# FEATURE_RETRY_MAX_SECONDS=300
# FEATURE_REBUILD_AFTER_FAILURES=3

# --- Object detection (app/object_detection) ----------------------------------------
# Off until switched on in the Analytics switches. Looks per second per camera.
# OBJECT_DETECTION_FPS=0.2
# Zero-shot fallback (downloads models; ignored when MODEL_OFFLINE_MODE=true).
# OBJECT_DETECTION_FALLBACK=false

# --- Retention -------------------------------------------------------------------
# RETENTION_INTERVAL_SECONDS=3600
# FACE_PENDING_RETENTION_DAYS=30
# FACE_CAPTURE_RETENTION_DAYS=60   # unlabeled/rejected only; labeled = kept
# SNAPSHOT_RETENTION_DAYS=30
# ALERT_SNAPSHOT_RETENTION_DAYS=90
# MODEL_BACKUP_RETENTION_COUNT=5
# MAX_TRAINING_CAPTURES=15000

# --- Logging ---------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_TO_FILE=false
# LOG_FILE_MAX_MB=20
# LOG_BACKUP_COUNT=10

# --- Unique footfall (app/reid/config.py) ------------------------------------------
# REID_SIMILARITY_THRESHOLD=0.75
# REID_MOT_INTERVAL_SECONDS=0.5
# REID_MIN_ASPECT_RATIO=1.5
# REID_LEARN_BELOW_SIMILARITY=0.88
# REID_MAX_EMBEDDINGS_PER_PERSON=30

# --- Live-view person boxes (app/face_pipeline.py) ----------------------------------
# Lighter settings for a CPU-only laptop:
# PERSON_DETECT_IMGSZ=640
# PERSON_RESCUE_INTERVAL_FRAMES=100000
